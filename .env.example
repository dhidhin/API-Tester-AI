# ==========================================
# API Tester AI — Environment Configuration Example
# ==========================================
# Copy this file to .env.local for local overrides.
# NOTE: API Keys entered in the UI are kept strictly in-memory
# and are NEVER saved to disk, database, or git repository.
# ==========================================

# Environment mode (development / production)
NODE_ENV=development

# Optional default port for Vite
PORT=5173

# Optional custom CORS origins (comma-separated, defaults to all in development)
# ALLOWED_ORIGINS=https://api-tester-ai-worker.cah2ban.workers.dev
